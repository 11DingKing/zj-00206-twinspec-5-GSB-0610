{
  "name": "twinspec",
  "version": "1.0.0",
  "description": "油电车型重量对比分析系统",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "ts-node prisma/seed.ts",
    "db:init": "prisma migrate dev --name init && npm run seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm install && npm run build && npm run db:init",
    "init": "npm run build && npm run db:init",
    "lint": "eslint \"src/**/*.ts\" \"prisma/seed.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/seed.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/seed.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
